---
import { Icon } from "astro-icon/components";
---

<section class="section section-contacts">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      <div>
        <h3 class="font-semibold text-xl lg:text-[40px]">Nous contacter</h3>
        <div class="mt-10 grid gap-6">
          <div
            class="grid grid-cols-[54px_1fr] gap-4 items-center dark:bg-dark dark:border-dark bg-gray-50 border border-gray-200 rounded-lg p-4"
          >
            <div
              class="bg-main text-white flex items-center justify-center rounded-full w-13.5 h-13.5"
            >
              <Icon name="lucide:phone-call" size={24} />
            </div>
            <div>
              <p class="font-semibold text-lg mb-0">Demande de devis</p>
              <a href="mailto:contact@nettopromaroc.online">Réponse rapide à Casablanca</a>
            </div>
          </div>

          <div
            class="grid grid-cols-[54px_1fr] gap-4 items-center dark:bg-dark dark:border-dark bg-gray-50 border border-gray-200 rounded-lg p-4"
          >
            <div
              class="bg-main text-white flex items-center justify-center rounded-full w-13.5 h-13.5"
            >
              <Icon name="lucide:mail" size={24} />
            </div>
            <div>
              <p class="font-semibold text-lg mb-0">Email</p>
              <a href="mailto:contact@nettopromaroc.online">contact@nettopromaroc.online</a>
            </div>
          </div>

          <div
            class="grid grid-cols-[54px_1fr] gap-4 items-center dark:bg-dark dark:border-dark bg-gray-50 border border-gray-200 rounded-lg p-4"
          >
            <div
              class="bg-main text-white flex items-center justify-center rounded-full w-13.5 h-13.5"
            >
              <Icon name="lucide:map-pin" size={24} />
            </div>
            <div>
              <p class="font-semibold text-lg mb-0">Zone d’intervention</p>
              <div
                ><address class="not-italic">
                  Casablanca et environs, Maroc
                </address></div
              >
            </div>
          </div>
        </div>
      </div>
      <div>
        <p class="text-sm mb-0">Contact</p>
        <h3 class="font-semibold text-xl lg:text-[40px] mb-3">Parlez-nous de votre besoin</h3>
        <p class="">
          Indiquez le type de local, la surface approximative, le quartier et
          la fréquence souhaitée. Nous revenons vers vous avec une proposition claire.
        </p>

        <form action="mailto:contact@nettopromaroc.online" method="POST" enctype="text/plain" class="mt-8 grid gap-3">
          <fieldset class="fieldset">
            <input
              type="text"
              placeholder="Nom"
              class="input w-full validator"
              id="contact-name"
              name="contact_name"
              required
            />
            <p class="validator-hint hidden">Obligatoire</p>
          </fieldset>

          <fieldset class="fieldset">
            <input
              type="text"
              placeholder="Email"
              class="input w-full validator"
              id="contact-email"
              name="contact_email"
              required
            />
            <p class="validator-hint hidden">Obligatoire</p>
          </fieldset>
          <fieldset class="fieldset">
            <textarea
              class="textarea w-full validator"
              placeholder="Votre message"
              id="contact-msg"
              name="contact_msg"
              required></textarea>
            <p class="validator-hint hidden">Obligatoire</p>
          </fieldset>
          <button
            class="btn bg-main border-main text-white rounded-lg hover:bg-green-600 shadow-none lg:mr-auto"
            type="submit">Envoyer la demande</button
          >
        </form>
      </div>
    </div>
  </div>
</section>
