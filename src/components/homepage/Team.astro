---
import TeamCard from "../card/TeamCard.astro";
import { getCollection } from "astro:content";

const team = (await getCollection("team"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section class="section section-services">
  <div class="container">
    <div
      class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-4 border-b border-b-main pb-10"
    >
      <h2 class="capitalize">
        Une équipe organisée pour chaque intervention
      </h2>
      <div>
        <div class="flex flex-wrap justify-between items-center gap-3">
          <p class="font-semibold mb-3 text-xl">Notre équipe</p>
          <p>
            <a href="/team" class="text-main underline hover:no-underline"
              >Voir l’équipe</a
            >
          </p>
        </div>
        <p class="mb-3">
          Les missions sont préparées selon le lieu, les produits nécessaires
          et le résultat attendu afin de livrer un espace propre et prêt à l’usage.
        </p>
      </div>
    </div>
    <div
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-10 mt-10 relative"
    >
      {team.map((people) => <TeamCard {...people} />)}
    </div>
  </div>
</section>
