---
const { mode = "light" } = Astro.props;
const textClass = mode === "dark" ? "text-white" : "text-dark dark:text-white";
---

<a href="/" class={`logo leading-none font-bold ${textClass}`} aria-label="Netto Pro Maroc Casablanca">
  <span class="block text-xl tracking-tight">Netto Pro Maroc</span>
  <span class="block text-sm font-semibold text-main">Casablanca</span>
</a>
