---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

const { id, data } = Astro.props;
---

<article class="group">
  <a href={`/team/${id}`}>
    <div
      class="bg-[radial-gradient(circle_at_center,transparent,__rgba(54,184,100,0.4))] bg-cover rounded-xl overflow-hidden w-full mb-4"
    >
      <Image
        src={data.thumbnail}
        alt={data.title}
        width="370"
        height="300"
        format="webp"
        quality={45}
        class="w-full h-auto object-cover"
      />
    </div>
    <h3 class="font-semibold text-xl sm:text-2xl group-hover:underline">
      {data.title}
    </h3>

    <div class="flex gap-1 items-center text-yellow-500 my-2">
      {
        Array.from({ length: data.rating }).map((star) => (
          <Icon name="heroicons:star-solid" size={24} />
        ))
      }
    </div>

    <p class="mt-4 text-sm sm:text-base">{data.description}</p>
  </a>
  <a href="/contact" class="inline-flex items-center gap-2 mt-4 text-main hover:underline">
    Contacter l’équipe <Icon name="lucide:arrow-up-right" size={18} />
  </a>
</article>
