---
const today = new Date();
import Logo from "./Logo.astro";
---

<footer class="footer bg-dark text-white gap-0 block">
  <div class="footer-top w-full py-20">
    <div class="container">
      <div class="grid grid-cols-1 sm:grid-cols-1 lg:grid-cols-3 gap-10">
        <div>
          <Logo mode="dark" />
          <p class="mt-4">
            Nettoyage professionnel à Casablanca pour habitations, bureaux,
            commerces, syndics et remises en état.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-10">
          <nav class="grid gap-3">
            <h3 class="text-xl font-semibold">Entreprise</h3>
            <a href="/about" class="hover:underline hover:text-main">À propos</a>
            <a href="/service" class="hover:underline hover:text-main"
              >Services</a
            >
            <a href="/team" class="hover:underline hover:text-main">Équipe</a>
          </nav>
          <nav class="grid gap-3">
            <h3 class="text-xl font-semibold">Informations</h3>
            <a href="/contact" class="hover:underline hover:text-main">Contact</a>
            <a href="/policy" class="hover:underline hover:text-main"
              >Confidentialité</a
            >
            <a href="/terms" class="hover:underline hover:text-main"
              >Conditions</a
            >
          </nav>
        </div>
        <div class="grid gap-3">
          <h3 class="text-xl font-semibold">Demande de devis</h3>

          <form
            action="/"
            method="GET"
            class="mt-3 grid gap-4 grid-cols-1 sm:grid-cols-[2fr_1fr] lg:grid-cols-1"
          >
            <input
              type="text"
              placeholder="Votre email"
              class="input text-black dark:text-white w-full"
              name="subcscribe_email"
              id="subscribe-email"
            />
            <button
              class="btn bg-main border-main text-white rounded-lg hover:bg-green-600 lg:mr-auto shadow-none"
              type="submit">Envoyer</button
            >
          </form>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-btm w-full">
    <div class="container text-center border-t border-white py-10">
      &copy; {today.getFullYear()} Netto Pro Maroc Casablanca. Tous droits réservés.
    </div>
  </div>
</footer>
